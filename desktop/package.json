{
  "name": "icpc-yoli",
  "productName": "ICPC yoʻli",
  "version": "1.1.1",
  "description": "ICPC tayyorgarlik yoʻl xaritasi — kompyuter uchun",
  "author": "muhammadiev",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "dist": "node scripts/write-config.cjs --strict && vite build && electron-builder --publish never",
    "config": "node scripts/write-config.cjs",
    "test": "node scripts/test-license.cjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.4",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "svelte": "^5.57.2",
    "svelte-check": "^4.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "uz.icpcyoli.desktop",
    "productName": "ICPC yoʻli",
    "artifactName": "ICPC-yoli-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "legalTrademarks": "ICPC yoʻli"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "ICPC-yoli-${version}-setup.${ext}",
      "license": "resources/installer-terms.txt",
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ICPC yoʻli",
      "uninstallDisplayName": "ICPC yoʻli",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "ICPC-yoli-${version}-portable.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "resources/icon.png",
      "category": "public.app-category.education"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "resources/icon.png",
      "category": "Education",
      "maintainer": "muhammadiev <nldgooner@gmail.com>"
    },
    "publish": null,
    "copyright": "© 2026 muhammadiev",
    "appx": {
      "applicationId": "ICPCyoli",
      "displayName": "ICPC yoʻli",
      "languages": [
        "uz-Latn-UZ",
        "en-US"
      ],
      "backgroundColor": "#1E9CC4",
      "showNameOnTiles": true,
      "artifactName": "ICPC-yoli-${version}-store.${ext}"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/miraeuz/learing-map.git"
  },
  "homepage": "https://github.com/miraeuz/learing-map"
}
